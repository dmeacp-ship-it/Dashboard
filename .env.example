# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
# Optional: lock CORS to a specific origin (defaults to *)
# CORS_ORIGIN=https://your-app.example.com

# ── Sessions (strongly recommended) ───────────────────────────────────────────
# HMAC key for the signed session tokens. If unset, the app derives one from
# SUPABASE_KEY, and if that is missing too it falls back to a hardcoded literal
# — which would make tokens forgeable. Set an independent random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: setting or changing this invalidates existing sessions once (everyone
# signs in again). It also decouples sessions from Supabase key rotation.
SESSION_SECRET=

# ── Emergency admin bootstrap (leave unset) ───────────────────────────────────
# Set to 1 ONLY to bootstrap a brand-new deployment before db/dashboard_users.sql
# has been run. It enables a built-in super admin whose credentials are published
# in this repo. Never enable it once real accounts exist.
# ALLOW_FALLBACK_ADMIN=1

# ── Supabase (required) ───────────────────────────────────────────────────────
# Same project URL + service key you used in the Apps Script Script Properties.
# The app reads the same views/tables: vw_monthly_agg, vw_hod_agg,
# vw_customer_summary, vw_customer_sale_agg, vw_sku_type_sale_agg, vw_brand_agg,
# vw_sku_agg, vw_outstanding_hod, target_master, user_profiles, etc.
SUPABASE_URL=
SUPABASE_KEY=

# ── AI (optional — Copilot / Ask-AI) ──────────────────────────────────────────
# Either naming works; *_API_KEY takes precedence (matches the original GAS keys).
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_KEY=
# GROQ_KEY=

# ── Google Sheets sync (optional — only for the Settings > Sync buttons) ───────
# Paste the FULL service-account JSON on one line, then share every source
# sheet (RAW DATA, CUSTOMER MASTER, TARGET_DATA) with the service-account email.
GOOGLE_SERVICE_ACCOUNT_JSON=
